# Template only. Set DATABASE_URL through your secrets manager.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
AUTH_PROVIDER=disabled
# For verified invite-only sign-in, use replit and an exact HTTPS origin.
# AUTH_ORIGIN=https://your-configured-host
# REPL_ID is supplied by Replit. For independent hosting, configure the OIDC
# client/provider registration separately; disabled remains the portable preview default.
REPORTING_TIMEZONE=America/Chicago
LOG_LEVEL=info
NODE_ENV=development
# Outside Replit only: one public gateway serving the web build and /api.
PORT=5000
BASE_PATH=/
# Absolute repository root is optional; auto-discovered by walking up for pnpm-workspace.yaml.
# PROJECT_ROOT=/absolute/path/to/northpoint
#
# No provider access/refresh tokens are persisted by Phase 1 sign-in.
#
# Phase 3 direct Planning Center integration (server Secrets only).
# Register a confidential OAuth application with the callback:
# ${AUTH_ORIGIN}/api/v1/admin/planning-center/callback
# PCO_CLIENT_ID=
# PCO_CLIENT_SECRET=
# PCO_TOKEN_ENCRYPTION_KEY=
# Required at API startup, even before connecting Planning Center.
# Application-owned encryption key: exactly 64 random hexadecimal characters (32 bytes).
# Generate once privately: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex') + '\n')"
# Save the output directly in Secrets; never paste it in chat or tool logs.
# Never commit a populated value or rotate the key without a token migration.
# No recurring scheduler. Admins can enable server-side run-to-completion for
# an existing resumable sync; automatic processing requires the API to be running.
